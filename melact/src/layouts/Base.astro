---
import { withBase } from "../data/paths";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "");
const nav = [
  { route: "how-it-works", label: "How it works" },
  { route: "migrating", label: "Migrating" },
  { route: "benchmarks", label: "Benchmarks" },
  { route: "getting-started", label: "Get started" },
].map((item) => ({ href: withBase(item.route), label: item.label }));
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const media = matchMedia("(prefers-color-scheme: dark)");
        const order = { system: "light", light: "dark", dark: "system" };
        const read = () => {
          try {
            return localStorage.getItem("theme") || "system";
          } catch {
            return "system";
          }
        };
        const apply = (choice) => {
          root.dataset.choice = choice;
          root.classList.toggle("dark", choice === "dark" || (choice === "system" && media.matches));
        };
        root.classList.remove("no-js");
        apply(read());
        media.addEventListener("change", () => apply(read()));
        document.addEventListener("click", (event) => {
          const toggle = event.target instanceof Element && event.target.closest("[data-theme-toggle]");
          if (!toggle) return;
          const next = order[read()] || "system";
          try {
            localStorage.setItem("theme", next);
          } catch {}
          apply(next);
        });
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only z-50 rounded-md bg-ink px-3 py-2 text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3">Skip to content</a>

    <header class="sticky top-0 z-40 border-b border-line/70 bg-bg/75 backdrop-blur-xl backdrop-saturate-150">
      <div class="wrap flex h-16 items-center justify-between gap-4">
        <a href={withBase("")} class="group flex items-center gap-2.5" aria-label="Melact, home">
          <img src={withBase("figures/logo.svg")} alt="" width="30" height="30" class="h-[30px] w-[30px] transition-transform duration-300 group-hover:rotate-[-6deg] dark:hidden" />
          <img src={withBase("figures/logo-dark.svg")} alt="" width="30" height="30" class="hidden h-[30px] w-[30px] transition-transform duration-300 group-hover:rotate-[-6deg] dark:block" />
          <span class="font-display text-lg font-bold tracking-tight text-ink">Melact</span>
          <span class="hidden rounded-full border border-line px-2 py-0.5 font-mono text-[0.65rem] text-ink-3 sm:inline">reason-react, no React</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex" aria-label="Main">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
                class="rounded-full px-3.5 py-1.5 text-sm text-ink-2 transition-colors hover:bg-bg-sunk hover:text-ink aria-[current=page]:bg-bg-sunk aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-1">
          <button
            type="button"
            data-theme-toggle
            class="grid h-9 w-9 place-items-center rounded-full text-ink-2 transition-colors hover:bg-bg-sunk hover:text-ink"
            aria-label="Switch theme: system, light, dark"
            title="Theme"
          >
            <svg class="hidden h-[18px] w-[18px] [[data-choice=system]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M8 20h8M12 16v4"></path></svg>
            <svg class="hidden h-[18px] w-[18px] [[data-choice=light]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="hidden h-[18px] w-[18px] [[data-choice=dark]_&]:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
          </button>
          <a
            href="https://github.com/jongleb/melact"
            class="grid h-9 w-9 place-items-center rounded-full text-ink-2 transition-colors hover:bg-bg-sunk hover:text-ink"
            aria-label="Melact on GitHub"
          >
            <svg class="h-[18px] w-[18px]" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
          </a>
          <details class="group/menu relative md:hidden">
            <summary class="grid h-9 w-9 cursor-pointer list-none place-items-center rounded-full text-ink-2 hover:bg-bg-sunk hover:text-ink" aria-label="Menu">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path class="group-open/menu:hidden" d="M4 7h16M4 12h16M4 17h16"></path><path class="hidden group-open/menu:block" d="M6 6l12 12M18 6L6 18"></path></svg>
            </summary>
            <nav class="absolute top-12 right-0 w-56 rounded-2xl border border-line bg-bg p-2 shadow-xl" aria-label="Mobile">
              {
                nav.map((item) => (
                  <a
                    href={item.href}
                    aria-current={path === item.href ? "page" : undefined}
                    class="block rounded-xl px-3 py-2.5 text-sm text-ink-2 hover:bg-bg-sunk hover:text-ink aria-[current=page]:bg-bg-sunk aria-[current=page]:text-ink"
                  >
                    {item.label}
                  </a>
                ))
              }
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 border-t border-line bg-bg-soft">
      <div class="wrap grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1.2fr]">
        <div>
          <p class="flex items-center gap-2 text-base font-semibold tracking-tight text-ink">
            <img src={withBase("figures/logo.svg")} alt="" width="22" height="22" class="h-[22px] w-[22px] dark:hidden" />
            <img src={withBase("figures/logo-dark.svg")} alt="" width="22" height="22" class="hidden h-[22px] w-[22px] dark:block" />
            Melact
          </p>
          <p class="mt-3 max-w-sm text-sm leading-relaxed text-ink-3">
            reason-react for Melange, without React and without a virtual DOM. MIT licensed.
          </p>
          <a href="https://github.com/jongleb/melact" class="mt-4 inline-block font-mono text-xs text-ink-2 hover:text-ink">github.com/jongleb/melact</a>
        </div>
        <div>
          <p class="eyebrow">Docs</p>
          <ul class="mt-4 space-y-2.5 text-sm">
            {nav.map((item) => <li><a class="text-ink-2 hover:text-ink" href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
        <a
          href="https://jongleb.github.io/melact-meltea-sites/meltea/"
          class="group flex items-start gap-4 self-start rounded-2xl border border-line p-4 transition-colors hover:border-line-strong hover:bg-bg-soft"
        >
          <img src={withBase("figures/meltea.svg")} alt="" width="40" height="40" class="h-10 w-10 shrink-0 dark:hidden" />
          <img src={withBase("figures/meltea-dark.svg")} alt="" width="40" height="40" class="hidden h-10 w-10 shrink-0 dark:block" />
          <span>
            <span class="eyebrow block">Sibling project</span>
            <span class="mt-1 block text-sm font-semibold text-ink">Meltea <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span></span>
            <span class="mt-1 block text-sm leading-snug text-ink-3">Starting fresh? The Elm architecture for OCaml, on the same compiler.</span>
          </span>
        </a>
      </div>
      <p class="wrap border-t border-line py-6 text-xs text-ink-3">
        React is a trademark of Meta Platforms, Inc. Melact is not affiliated with or endorsed by Meta.
      </p>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) =>
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          }),
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
