---
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHead from "../components/SectionHead.astro";
import BenchChart from "../components/BenchChart.astro";

const apps = [
  { name: "vanilla/", text: "hand-written keyed DOM code in the style of the benchmark's vanillajs-keyed: one cloned <tr> template, event delegation on tbody, manual keyed operations" },
  { name: "melact/", text: "reason-react style: useReducer in an App component, a React.memo Row component" },
  { name: "react/", text: "React 18.3 with hooks, like the benchmark's react-hooks: useReducer, memo rows, createElement" },
];

const method = [
  "Every sample is a fresh tab: load, the benchmark's warmups for that operation, then one measured click, sent as real mouse input.",
  "The measured click is traced. The time is the renderer main thread's busy time from the start of the click dispatch to the end of the first Paint and its Commit after it.",
  "CPU slowdown as in the benchmark: 4× for partial update, select, swap and clear, 2× for remove.",
  "After every measured click the page is checked: row count, every id in order, every label, the markup of every row, and which rows have class=\"danger\". A fast but wrong result is reported, not counted silently.",
  "Memory: HeapProfiler.collectGarbage twice, then Runtime.getHeapUsage, after load, after creating 1,000 rows, and after five more create/clear cycles.",
  "Size: the gzip (-9) size of all JS in the production bundle.",
];
---

<Base title="Melact benchmarks" description="Melact against hand-written vanilla JS and React 18 on js-framework-benchmark's keyed operations.">
  <PageHeader eyebrow="Benchmarks" title="Keyed benchmark results">
    Our local reproduction of js-framework-benchmark's keyed CPU, memory and size tests, run in headless Chrome against hand-written vanilla JS and React 18.3
    with hooks. Times are the geometric mean of the slowdown against vanilla JS over nine keyed operations; the ratios move by about 0.1 between runs.
  </PageHeader>

  <section class="wrap py-16 sm:py-20">
    <div class="grid gap-6 lg:grid-cols-2">
      <BenchChart metric="speed" />
      <BenchChart metric="size" />
      <BenchChart metric="heap" />
      <BenchChart metric="swap" />
    </div>
    <p class="reveal mt-6 text-sm text-ink-3">
      Swapping two rows of 1,000 moves two rows; React moves 998. A list re-renders only the rows whose item changed.
    </p>
  </section>

  <section class="wrap py-12">
    <SectionHead eyebrow="The figure" title="Where the time goes." >
      Pale: the work itself. Solid: the overhead on top of it.
    </SectionHead>
    <Figure
      class="mt-10"
      name="speed"
      alt="Benchmark: within ×1.2 of hand-written JavaScript. js-framework-benchmark's keyed operations in headless Chrome, slowdown against vanilla JS, lower is better: vanilla 1.00, Meltea 1.15, Melact 1.17, React 18 1.70. JS bundle of the benchmark app, gzip: vanilla 1.4 kB, Meltea 9.0, Melact 9.9, React 18 45.6. Heap with 1,000 rows: vanilla 0.77 MB, Meltea 1.22, Melact 1.64, React 18 3.17. Swapping two rows of 1,000: Meltea 1.12, Melact 1.17, React 18 5.86"
    />
  </section>

  <section class="wrap py-16">
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <SectionHead eyebrow="Apps" title="Same markup, same stylesheet." />
        <ul class="mt-8 space-y-4">
          {
            apps.map((app) => (
              <li class="reveal card p-5">
                <p class="font-mono text-sm font-medium text-ink">{app.name}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-2">{app.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <SectionHead eyebrow="Method" title="Measured like the real benchmark." />
        <ul class="reveal prose-site mt-8 text-[0.95rem]">
          {method.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap py-16">
    <SectionHead eyebrow="Whole apps" title="Small, because the runtime is made of parts.">
      Every kind of child carries its own mount and patch code, and every hole its own writer, so a bundle contains only the parts its compiled code names. Whole
      apps, runtime and the Melange stdlib they use included: the counter is 5.6 kB gzip with Melact; React 18.3 and react-dom alone are 45 kB.
    </SectionHead>
  </section>
</Base>
