---
import { withBase } from "../data/paths";
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  name: string;
  alt: string;
  caption?: string;
  class?: string;
}

const { name, alt, caption, class: className } = Astro.props;
const [, , width, height] = (
  readFileSync(join(process.cwd(), "public/figures", `${name}.svg`), "utf8").match(/viewBox="([^"]+)"/)?.[1] ?? "0 0 896 480"
)
  .trim()
  .split(/\s+/)
  .map(Number);
---

<figure class:list={["reveal group", className]}>
  <div class="relative overflow-hidden rounded-2xl border border-line bg-bg p-3 shadow-[0_1px_2px_rgba(0,0,0,0.04),0_12px_40px_-20px_rgba(20,20,40,0.25)] sm:p-5 dark:shadow-none">
    <img src={withBase(`figures/${name}.svg`)} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="block h-auto w-full dark:hidden" />
    <img src={withBase(`figures/${name}-dark.svg`)} alt={alt} width={width} height={height} loading="lazy" decoding="async" class="hidden h-auto w-full dark:block" />
  </div>
  {caption && <figcaption class="mt-3 px-1 text-sm leading-relaxed text-ink-3">{caption}</figcaption>}
</figure>
