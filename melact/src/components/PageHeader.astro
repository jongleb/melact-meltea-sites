---
import Funnel from "./Funnel.astro";
import Dunes from "./Dunes.astro";
import Stars from "./Stars.astro";

interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props;
---

<section class="sky relative overflow-hidden">
  <Stars count={40} />
  <div class="glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <Funnel class="absolute top-6 right-[-6rem] hidden h-[420px] w-[420px] opacity-50 md:block" />
  <div class="wrap relative pt-16 pb-4 sm:pt-24">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-center">
      <slot name="mark" />
      <div class="max-w-3xl">
        <p class="eyebrow">{eyebrow}</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-[-0.035em] text-balance text-ink sm:text-5xl lg:text-6xl">{title}</h1>
        <div class="lede mt-5 max-w-2xl">
          <slot />
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <slot name="actions" />
        </div>
      </div>
    </div>
  </div>
  <Dunes next="bg" scene="plain" />
</section>
