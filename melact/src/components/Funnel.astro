---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const ember = `ember-${crypto.randomUUID().slice(0, 8)}`;
const frames = [
  { size: 228, radius: 60, turn: 4, opacity: 0.16, duration: "90s" },
  { size: 190, radius: 50, turn: 10, opacity: 0.22, duration: "74s" },
  { size: 152, radius: 41, turn: 17, opacity: 0.3, duration: "61s" },
  { size: 116, radius: 32, turn: 25, opacity: 0.4, duration: "50s" },
  { size: 82, radius: 23, turn: 34, opacity: 0.52, duration: "41s" },
].map((frame) => ({ ...frame, offset: 120 - frame.size / 2 }));
const modes = [
  { group: "moving", spin: "spin" },
  { group: "resting", spin: "still" },
] as const;
---

<svg viewBox="0 0 240 240" class:list={["pointer-events-none overflow-visible", className]} aria-hidden="true" fill="none">
  <defs>
    <radialGradient id={ember} cx="0.4" cy="0.35" r="0.75">
      <stop offset="0" stop-color="#ffc27a" />
      <stop offset="1" stop-color="#e2600c" />
    </radialGradient>
  </defs>
  {
    modes.map((mode) => (
      <g class={mode.group}>
        {frames.map((frame) => (
          <g transform={`rotate(${frame.turn} 120 120)`}>
            <rect x={frame.offset} y={frame.offset} width={frame.size} height={frame.size} rx={frame.radius} stroke="var(--funnel)" stroke-width="2" opacity={frame.opacity}>
              {mode.spin === "spin" && (
                <animateTransform attributeName="transform" type="rotate" from="0 120 120" to="360 120 120" dur={frame.duration} repeatCount="indefinite" />
              )}
            </rect>
          </g>
        ))}
      </g>
    ))
  }
  <circle cx="120" cy="120" r="34" fill="var(--accent-2)" opacity="0.18" />
  <rect x="104" y="104" width="32" height="32" rx="10" fill={`url(#${ember})`} />
</svg>
