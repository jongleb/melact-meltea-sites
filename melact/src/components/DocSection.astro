---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
}

const { id, eyebrow, title } = Astro.props;
---

<section id={id} class="scroll-mt-24" aria-labelledby={`${id}-title`}>
  <div class="reveal">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={`${id}-title`} class="mt-3 font-display text-2xl font-bold tracking-[-0.025em] text-balance text-ink sm:text-3xl">{title}</h2>
  </div>
  <div class="prose-site mt-5 space-y-6">
    <slot />
  </div>
</section>
