---
import { frameworks, metrics } from "../data/bench";

interface Props {
  metric: keyof typeof metrics;
  class?: string;
}

const { metric, class: className } = Astro.props;
const { title, question, direction, rows, baseline } = metrics[metric];
const domain = Math.max(...rows.map((row) => row.value)) * 1.32;
const percent = (value: number) => `${((value / domain) * 100).toFixed(2)}%`;
---

<figure class:list={["reveal card flex flex-col p-5 sm:p-7", className]} aria-labelledby={`chart-${metric}`}>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 id={`chart-${metric}`} class="text-base font-semibold tracking-tight text-ink">{title}</h3>
      <p class="mt-1 text-sm text-ink-3">{question}</p>
    </div>
    <span class="shrink-0 rounded-full border border-line px-2.5 py-1 font-mono text-[0.68rem] text-ink-3">{direction}</span>
  </div>

  <div class="relative mt-7 mb-1">
    <div class="pointer-events-none absolute -inset-y-3 inset-x-0 grid grid-cols-[5.5rem_1fr] gap-3 sm:grid-cols-[6.5rem_1fr]" aria-hidden="true">
          <span />
          <span class="relative">
            <span class="absolute inset-y-0 border-l border-dashed border-ink-3/70" style={{ left: percent(baseline.value) }} />
            <span class="absolute -top-4 pl-1.5 font-mono text-[0.65rem] whitespace-nowrap text-ink-3" style={{ left: percent(baseline.value) }}>
              vanilla JS {baseline.shown}
            </span>
          </span>
    </div>
    <ul class="relative space-y-3">
      {
        rows.map((row) => (
          <li class="group/bar grid grid-cols-[5.5rem_1fr] items-center gap-3 sm:grid-cols-[6.5rem_1fr]">
            <span class="flex items-center gap-2 text-sm font-medium text-ink">
              <span class="h-2.5 w-2.5 rounded-[3px]" style={{ background: frameworks[row.framework].color }} />
              {frameworks[row.framework].name}
            </span>
            <span class="relative flex h-7 items-center">
              <span
                class="bar block h-[22px] rounded-r-[4px] transition-[filter] group-hover/bar:brightness-110"
                style={{ width: percent(row.value), background: frameworks[row.framework].color }}
                title={`${frameworks[row.framework].name}: ${row.shown}`}
              />
              <span class="ml-2.5 font-mono text-sm font-medium whitespace-nowrap text-ink tabular-nums">{row.shown}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <details class="group/table mt-auto pt-5">
    <summary class="cursor-pointer list-none font-mono text-xs text-ink-3 select-none hover:text-ink">
      <span class="inline-block transition-transform group-open/table:rotate-90">›</span> table
    </summary>
    <table class="mt-3 w-full text-left text-sm">
      <thead>
        <tr class="border-b border-line text-ink-3">
          <th scope="col" class="py-1.5 font-medium">framework</th>
          <th scope="col" class="py-1.5 text-right font-medium">{question}</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-line/60">
          <td class="py-1.5 text-ink-2">vanilla JS</td>
          <td class="py-1.5 text-right font-mono text-ink-2 tabular-nums">{baseline.shown}</td>
        </tr>
        {
          rows.map((row) => (
            <tr class="border-b border-line/60 last:border-0">
              <td class="py-1.5 text-ink">{frameworks[row.framework].name}</td>
              <td class="py-1.5 text-right font-mono text-ink tabular-nums">{row.shown}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>
