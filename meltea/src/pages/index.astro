<script is:inline type="module" src={withBase("/demo/meltea-counter.js")}></script>

<script>
  const glass = document.querySelector<HTMLElement>("[data-glass]");
  const root = document.getElementById("root");
  if (glass && root) {
    let writes = 0;
    const show = (output: HTMLOutputElement) => {
      const count = Number(output.textContent ?? "0");
      glass.style.setProperty("--level", String(count < 0 ? 0.05 : Math.min(1, 0.22 + count * 0.078)));
      glass.dataset.sign = count < 0 ? "negative" : "positive";
      glass.querySelectorAll("[data-live-count]").forEach((node) => (node.textContent = output.textContent ?? ""));
      glass.querySelectorAll("[data-live-writes]").forEach((node) => (node.textContent = String(writes)));
    };
    const watch = (output: HTMLOutputElement) => {
      show(output);
      new MutationObserver((records) => {
        writes += records.length;
        show(output);
      }).observe(output, { characterData: true, childList: true, subtree: true });
    };
    const mounted = root.querySelector("output");
    if (mounted) watch(mounted);
    else {
      const waiting = new MutationObserver(() => {
        const output = root.querySelector("output");
        if (output) {
          waiting.disconnect();
          watch(output);
        }
      });
      waiting.observe(root, { childList: true, subtree: true });
    }
  }
</script>

