---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHead from "../components/SectionHead.astro";
import BenchChart from "../components/BenchChart.astro";
import Figure from "../components/Figure.astro";
import Ornament from "../components/Ornament.astro";

const apps = [
  { name: "Counter", size: "3.0 kB", note: "the whole app, runtime and the Melange stdlib it uses included" },
  { name: "TodoMVC", size: "14.7 kB", note: "most of it jsonkit's Printf for error messages" },
  { name: "React 18.3 + react-dom", size: "45 kB", note: "the two libraries alone, before any app code" },
];

const method = [
  "Every sample is a fresh tab: load, the benchmark's warmups for that operation, then one measured click, sent as real mouse input.",
  "The measured click is traced. The time is the renderer main thread's busy time from the start of the click dispatch to the end of the first Paint and its Commit after it.",
  "CPU slowdown as in the benchmark: 4× for partial update, select, swap and clear, 2× for remove.",
  "After every measured click the page is checked: row count, every id in order, every label, the markup of every row, and which rows have class=\"danger\". A fast but wrong result is reported, not counted silently.",
  "Memory: two forced garbage collections, then the heap usage after creating 1,000 rows.",
  "Size: the gzip (-9) size of all JS in the production bundle.",
];
---

<Base
  title="Meltea benchmarks: within ×1.2 of hand-written JavaScript"
  description="js-framework-benchmark's keyed operations in headless Chrome: Meltea against hand-written vanilla JS and React 18, for time, bundle size and memory."
>
  <PageHeader eyebrow="Benchmarks" title="Within ×1.2 of hand-written JavaScript.">
    A local reproduction of the keyed CPU, memory and size tests of js-framework-benchmark, in headless Chrome, for Meltea against hand-written vanilla JS
    and React 18 with hooks. The ratios move by about 0.1 between runs.
  </PageHeader>

  <section class="wrap py-16 sm:py-20">
    <div class="grid gap-5 lg:grid-cols-2">
      <BenchChart metric="speed" />
      <BenchChart metric="size" />
      <BenchChart metric="heap" />
      <BenchChart metric="swap" />
    </div>
    <p class="reveal mt-6 max-w-3xl text-sm leading-relaxed text-ink-3">
      Swapping two rows of 1,000 is two DOM moves in Meltea; React moves 998. A list re-renders only the rows whose item changed.
    </p>
  </section>

  <section class="wrap py-12">
    <Ornament kind="divider" class="mb-16" />
    <SectionHead eyebrow="The whole picture" title="Time, size and memory in one figure." />
    <Figure
      class="mt-10"
      name="speed"
      alt="Benchmark: within ×1.2 of hand-written JavaScript. js-framework-benchmark's keyed operations in headless Chrome, slowdown against vanilla JS, lower is better: vanilla 1.00, Meltea 1.15, Melact 1.17, React 18 1.70. JS bundle of the benchmark app, gzip: vanilla 1.4 kB, Meltea 9.0, Melact 9.9, React 18 45.6. Heap with 1,000 rows: vanilla 0.77 MB, Meltea 1.22, Melact 1.64, React 18 3.17. Swapping two rows of 1,000: Meltea 1.12, Melact 1.17, React 18 5.86"
    />
  </section>

  <section class="wrap py-16 sm:py-20">
    <SectionHead eyebrow="Whole apps" title="Small glasses.">
      Sizes of whole apps, gzip, with the runtime and the Melange stdlib they use included. Unused parts of the runtime drop out of the bundle.
    </SectionHead>
    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {
        apps.map((app) => (
          <li class="reveal card p-7">
            <Ornament kind="glass" class="h-8 w-6" />
            <p class="display mt-4 text-[2.8rem] leading-none">{app.size}</p>
            <p class="mt-3 text-sm font-semibold text-ink">{app.name}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-2">{app.note}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-y border-line bg-bg-soft/60 py-16 sm:py-24">
    <div class="wrap grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
      <SectionHead eyebrow="Method" title="Measured the way js-framework-benchmark measures.">
        The four apps render the same markup and share one small inline stylesheet; the harness downloads nothing. Vanilla is hand-written keyed DOM code in
        the style of the benchmark's <code>vanillajs-keyed</code>; React is 18.3 with hooks, like the benchmark's <code>react-hooks</code>.
      </SectionHead>
      <ul class="reveal glass-list space-y-4 text-[0.98rem] leading-relaxed text-ink-2">
        {method.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </section>
</Base>
