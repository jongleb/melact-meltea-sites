---
import { withBase } from "../data/paths";
interface Props {
  name: "logo" | "meltea";
  alt: string;
  class?: string;
}

const { name, alt, class: className } = Astro.props;
---

<span class:list={["inline-flex shrink-0", className]}>
  <img src={withBase(`/figures/${name}.svg`)} alt={alt} width="120" height="120" class="h-full w-full dark:hidden" />
  <img src={withBase(`/figures/${name}-dark.svg`)} alt={alt} width="120" height="120" class="hidden h-full w-full dark:block" />
</span>
