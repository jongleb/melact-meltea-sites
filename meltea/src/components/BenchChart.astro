---
import { series, metrics } from "../data/bench";

interface Props {
  metric: keyof typeof metrics;
  class?: string;
}

const { metric, class: className } = Astro.props;
const { title, question, direction, rows } = metrics[metric];
const domain = Math.max(...rows.map((row) => row.value)) * 1.22;
---

<figure class:list={["reveal card flex flex-col p-6 sm:p-8", className]} aria-labelledby={`chart-${metric}`}>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h3 id={`chart-${metric}`} class="text-base font-semibold tracking-tight text-ink">{title}</h3>
      <p class="mt-1 text-sm text-ink-3">{question}</p>
    </div>
    <span class="shrink-0 rounded-full border border-line px-2.5 py-1 text-[0.7rem] font-medium text-brass">{direction}</span>
  </div>

  <ul class="mt-7 space-y-3.5">
    {
      rows.map((row) => (
        <li class="group/bar grid grid-cols-[5.25rem_minmax(0,1fr)] items-center gap-3 sm:grid-cols-[6rem_minmax(0,1fr)]">
          <span class="flex items-center gap-2 text-sm font-medium text-ink">
            <span class="h-2.5 w-2.5 rounded-full" style={{ background: series[row.series].color }} />
            {series[row.series].name}
          </span>
          <span class="flex h-7 min-w-0 items-center">
            <span
              class="bar block h-[22px] rounded-r-[4px] transition-[filter] group-hover/bar:brightness-110"
              style={{ width: `${((row.value / domain) * 100).toFixed(2)}%`, background: series[row.series].color }}
              title={`${series[row.series].name}: ${row.shown}`}
            />
            <span class="ml-2.5 font-mono text-sm font-medium whitespace-nowrap text-ink tabular-nums">{row.shown}</span>
          </span>
        </li>
      ))
    }
  </ul>

  <details class="group/table mt-auto pt-6">
    <summary class="cursor-pointer list-none text-xs font-medium text-ink-3 select-none hover:text-ink">
      <span class="inline-block transition-transform group-open/table:rotate-90">›</span> Show as a table
    </summary>
    <table class="mt-3 w-full text-left text-sm">
      <thead>
        <tr class="border-b border-line text-ink-3">
          <th scope="col" class="py-1.5 font-medium">framework</th>
          <th scope="col" class="py-1.5 text-right font-medium">{question}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-line/60 last:border-0">
              <td class="py-1.5 text-ink">{series[row.series].name}</td>
              <td class="py-1.5 text-right font-mono text-ink tabular-nums">{row.shown}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
</figure>
