---
import Ornament from "./Ornament.astro";

interface Props {
  eyebrow: string;
  title: string;
  id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<div class="reveal max-w-3xl">
  <p class="eyebrow"><Ornament kind="tulip" class="h-5 w-4" />{eyebrow}</p>
  <h2 id={id} class="h-section mt-3">{title}</h2>
  <div class="lede mt-4 empty:hidden">
    <slot />
  </div>
</div>
